MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 18
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/18
  isPlayerSpeaking: 0
  text: "Agradezco su compasi\xF3n, padre./nSolo espero que el alma del hijo del
    molinero pueda perdonarme tambi\xE9n."
  childrenIDs:
  - CL_V.1/22
