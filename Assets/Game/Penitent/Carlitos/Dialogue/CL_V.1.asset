  m_Name: 22
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/22
  isPlayerSpeaking: 0
  text: Carlitos se retira./nTe sientes bien./nLa Iglesia desaprueba que absuelvas
    sus pecados.
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3244
    y: 393
    width: 300
    height: 200
  faithCost: 0
