MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 21
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/21
  isPlayerSpeaking: 0
  text: Carlitos se retira./nAl pueblo le disgustan tus acusaciones./nTe sientes
    sucio.
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3243
    y: 195
    width: 300
    height: 200
  faithCost: 0
