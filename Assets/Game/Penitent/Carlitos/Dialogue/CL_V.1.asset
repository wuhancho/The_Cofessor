--- !u!114 &-3115589513559225906
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/1
  isPlayerSpeaking: 0
  text: "Padre, hay algo que necesito contarle./nHace unos d\xEDas, vi a dos personas
    detr\xE1s de la iglesia./nUna le estaba entregando a la otra un colgante a cambio
    de dinero."
  childrenIDs:
  - CL_V.1/2
  - CL_V.1/3
  - 2
  - 3
  rect:
    serializedVersion: 2
    x: -4
    y: 3
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: 7842016779124046565, guid: 798d6f6afe3d7fd4ba028b9553338ac4, type: 3}
--- !u!114 &-2066226742369860214
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 8
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/8
  isPlayerSpeaking: 1
  text: "\xBFQu\xE9 crees que era el colgante?"
  childrenIDs:
  - CL_V.1/10
  - 10
  rect:
    serializedVersion: 2
    x: 1441
    y: 281
    width: 300
    height: 200
