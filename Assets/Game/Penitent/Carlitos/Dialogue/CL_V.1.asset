--- !u!114 &4129213942553528069
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/10
  isPlayerSpeaking: 0
  text: "No lo s\xE9, padre./nPero le puedo asegurar que su naturaleza era malvada./nSu
    sola presencia fue suficiente para helarme la sangre./n.../nCreo que no deber\xEDa
    hablar m\xE1s de ello."
  childrenIDs:
  - CL_V.1/11
  - 11
  rect:
    serializedVersion: 2
    x: 1794
    y: 282
    width: 300
    height: 200
