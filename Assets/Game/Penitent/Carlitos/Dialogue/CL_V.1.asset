  m_Name: 3
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/3
  isPlayerSpeaking: 1
  text: "\xBFPor qu\xE9 no me dijiste nada?"
  childrenIDs:
  - CL_V.1/5
  - 5
