  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 15
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/15
  isPlayerSpeaking: 1
  text: "Encubrimiento: No dir\xE9 nada, pero tu conciencia ser\xE1 la que juzgue
    tu pecado de omisi\xF3n."
  childrenIDs:
  - CL_V.1/19
  - 19
  rect:
    serializedVersion: 2
    x: 2547.5796
    y: 597
    width: 300
    height: 200
