--- !u!114 &1688605838012437786
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 19
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/19
  isPlayerSpeaking: 0
  text: "Jam\xE1s olvidar\xE9 este d\xEDa./nLa muerte de aquel chico siempre permanecer\xE1
    en mi memoria./nComo un recordatorio de mi miedo y ego\xEDsmo."
  childrenIDs:
  - CL_V.1/23
  - 23
  rect:
    serializedVersion: 2
    x: 2886.5422
    y: 597
