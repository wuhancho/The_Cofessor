  m_Name: 13
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/13
  isPlayerSpeaking: 1
  text: "Denuncia: Fuiste ego\xEDsta al pensar solo en tu propia seguridad."
  childrenIDs:
  - CL_V.1/17
  - 17
