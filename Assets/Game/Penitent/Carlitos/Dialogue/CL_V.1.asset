--- !u!114 &-802693068398978832
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 20
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/20
  isPlayerSpeaking: 0
  text: Carlitos se retira./nLa iglesia aprueba la penitencia impuesta para expiar
    sus pecados./nTe sientes bien.
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3245
    y: -6
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: 0}
--- !u!114 &-783545019219105655
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 9
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/9
  isPlayerSpeaking: 0
  text: "Le est\xE1 mintiendo./nNo s\xE9 en qu\xE9, pero puedo sentirlo./nEse hombre
    es experto en ocultar sus verdaderas intenciones./nY no solo \xE9l.../nEl alcalde
    tambi\xE9n oculta algo."
  childrenIDs:
  - CL_V.1/11
  - 11
  rect:
    serializedVersion: 2
    x: 1794
    y: -9
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: -8428083734279256767, guid: 798d6f6afe3d7fd4ba028b9553338ac4, type: 3}
--- !u!114 &-467322774127043055
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 5
  m_EditorClassIdentifier: 
  uniqueID: CL_V.1/5
  isPlayerSpeaking: 0
  text: "Ten\xEDa mucho miedo./nAunque solo hab\xEDa dos personas, escuch\xE9 tres
    voces./nEstaba seguro de que no deber\xEDa haber visto aquello."
  childrenIDs:
  - CL_V.1/6
  - 6
  rect:
    serializedVersion: 2
    x: 694
    y: 246
    width: 300
    height: 200
  faithCost: 0
