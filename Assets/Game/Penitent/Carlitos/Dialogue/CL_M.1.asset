  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: CL_M.1/10
  isPlayerSpeaking: 0
  text: ".../nNo deber\xEDa hablar de esto."
  childrenIDs:
  - CL_M.1/11
  - 11
