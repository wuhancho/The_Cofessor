  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 22
  m_EditorClassIdentifier: 
  uniqueID: CL_M.1/22
  isPlayerSpeaking: 0
  text: Carlitos se retira./nTe sientes bien./nLa Iglesia desaprueba que absuelvas
    sus pecados.
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3294
    y: 391
    width: 300
    height: 200
