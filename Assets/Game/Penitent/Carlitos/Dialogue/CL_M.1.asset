--- !u!114 &-5952523456190080373
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 17
  m_EditorClassIdentifier: 
  uniqueID: CL_M.1/17
  isPlayerSpeaking: 0
  text: "Lo s\xE9./nY merezco ser castigado por ello./nUn ni\xF1o ha perdido la vida
    por mi culpa./nNi siquiera merezco ser su sirviente, padre."
  childrenIDs:
  - CL_M.1/21
  - 21
  rect:
    serializedVersion: 2
    x: 2943
    y: 194
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-4442506676157160297
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 11
  m_EditorClassIdentifier: 
  uniqueID: CL_M.1/11
  isPlayerSpeaking: 0
  text: "Yo sab\xEDa que el objeto que vi era peligroso./nPero ten\xEDa miedo de
    lo que podr\xEDa pasarme./nNo puedo evitar pensar que yo mismo soy responsable
    de la muerte del chico."
  childrenIDs:
  - CL_M.1/12
  - CL_M.1/13
  - CL_M.1/14
  - CL_M.1/15
  - 12
  - 13
  - 14
  - 15
  rect:
    serializedVersion: 2
    x: 2245
    y: 115
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
