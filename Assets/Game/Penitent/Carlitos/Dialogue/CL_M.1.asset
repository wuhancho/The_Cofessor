  m_Name: 6
  m_EditorClassIdentifier: 
  uniqueID: CL_M.1/6
  isPlayerSpeaking: 0
  text: "El hombre parec\xEDa estar desesperado por deshacerse de aquel objeto./nPodr\xEDa
    tener que ver con la muerte del hijo del molinero."
  childrenIDs:
  - CL_M.1/7
  - CL_M.1/8
  - 7
  - 8
  rect:
    serializedVersion: 2
    x: 1142
    y: 129
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
