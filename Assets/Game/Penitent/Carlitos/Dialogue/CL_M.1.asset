--- !u!114 &-8188299459582032919
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 19
  m_EditorClassIdentifier: 
  uniqueID: CL_M.1/19
  isPlayerSpeaking: 0
  text: "Jam\xE1s olvidar\xE9 este d\xEDa./nLa muerte de aquel chico siempre permanecer\xE1
    en mi memoria./nComo un recordatorio de mi miedo y ego\xEDsmo."
  childrenIDs:
  - CL_M.1/23
  - 23
  rect:
    serializedVersion: 2
    x: 2941
    y: 593
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
