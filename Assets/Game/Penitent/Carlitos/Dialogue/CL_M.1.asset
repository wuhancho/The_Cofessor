--- !u!114 &5173109210343764764
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  uniqueID: CL_M.1/4
  isPlayerSpeaking: 0
  text: "No. Apenas pude verles el rostro./nHab\xEDa una mujer./nNunca hab\xEDa escuchado
    su voz./n\"El otro era un hombre con una voz... Familiar./nCreo que podr\xEDa
    tratarse de \xC9dgar, el mercader."
  childrenIDs:
  - CL_M.1/6
  - 6
  rect:
    serializedVersion: 2
    x: 745
    y: 0
    width: 300
    height: 200
  faithCost: 0
