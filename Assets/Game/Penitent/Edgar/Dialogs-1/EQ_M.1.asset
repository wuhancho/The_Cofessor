--- !u!114 &3863975131166288050
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 16
  m_EditorClassIdentifier: 
  uniqueID: EQ_M.1/16
  isPlayerSpeaking: 0
  text: "AhahaAHAHAH.../nAl final, hasta t\xFA buscas c\xF3mo sacar tajada./nPadre,
    creo que t\xFA y yo podr\xEDamos llevarnos muy bien./nSin embargo, soy un charlat\xE1n./nPodr\xEDa
    irme de la lengua y, durante una desafortunada embriaguez, revelar sus... Intereses
    econ\xF3micos./nClaro que por unas monedas, evitaremos que ocurra./nYa sabe,
    por el porvenir de nuestra amistad."
  childrenIDs:
  - EQ_M.1/20
  - EQ_M.1/21
  - 20
  - 21
  rect:
    serializedVersion: 2
    x: 2941
    y: -6
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: -3598286242599313600, guid: 1f831341f1a79e146a5e201d991302f1, type: 3}
  indexNote: 
