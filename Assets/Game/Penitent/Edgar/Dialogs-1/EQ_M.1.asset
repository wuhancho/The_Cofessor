--- !u!114 &1362154410313605573
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: 
  uniqueID: EQ_M.1/1
  isPlayerSpeaking: 0
  text: "Estoy muy preocupado, padre./nLos rumores sobre el colgante maldito son
    cada vez m\xE1s fuertes./nY muchos ya empiezan a creer que yo tengo algo que
    ver./nSi no consigo limpiar mi nombre, mi negocio se hundir\xE1."
  childrenIDs:
  - EQ_M.1/2
  - EQ_M.1/3
  - 2
  - 3
  rect:
    serializedVersion: 2
    x: 4.2857056
    y: 117.142876
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: -1018107498758418939, guid: 1f831341f1a79e146a5e201d991302f1, type: 3}
  indexNote: 
--- !u!114 &1652018856758523282
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 14
  m_EditorClassIdentifier: 
  uniqueID: EQ_M.1/14
  isPlayerSpeaking: 1
  text: "Absoluci\xF3n: Quiz\xE1 utilices el enga\xF1o, pero intentas que las vidas
    de los dem\xE1s sean felices."
  childrenIDs:
  - EQ_M.1/18
  - 18
  rect:
    serializedVersion: 2
    x: 2591
    y: 395
    width: 300
    height: 200
  faithCost: -1
  RepIglesiaCost: 1
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: 0}
  indexNote: 
--- !u!114 &3709601589760471708
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
