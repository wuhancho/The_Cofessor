  m_Name: 19
  m_EditorClassIdentifier: 
  uniqueID: EQ_M.1/19
  isPlayerSpeaking: 0
  text: "Por supuesto./nAqu\xED tiene./nA cambio de este favor, la pr\xF3xima vez
