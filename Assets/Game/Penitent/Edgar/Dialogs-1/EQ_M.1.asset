  m_Name: 24
  m_EditorClassIdentifier: 
  uniqueID: EQ_M.1/24
  isPlayerSpeaking: 0
  text: "\xC9dgar se retira./nEl pueblo no conf\xEDa en \xC9dgar. Aplauden tu decisi\xF3n./nTe
    sientes bien."
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3355
    y: 397
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
