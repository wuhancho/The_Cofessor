  m_Name: 8
  m_EditorClassIdentifier: 
  uniqueID: EQ_V.1/8
  isPlayerSpeaking: 1
  text: "\xBFSus productos son art\xEDculos m\xE1gicos?"
  childrenIDs:
  - EQ_V.1/10
  - 10
  rect:
    serializedVersion: 2
    x: 1388
    y: 296
