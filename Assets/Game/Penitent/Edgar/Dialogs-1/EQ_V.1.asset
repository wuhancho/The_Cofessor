  m_Name: 18
  m_EditorClassIdentifier: 
  uniqueID: EQ_V.1/18
  isPlayerSpeaking: 0
  text: "\xBFEso es todo?/nA decir verdad, no esperaba que me dejaras marchar sin
    m\xE1s./nTomar\xE9 esta oportunidad para limpiar mi imagen y arreglar este malentendido."
  childrenIDs:
