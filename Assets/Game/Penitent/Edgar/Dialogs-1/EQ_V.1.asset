  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: EQ_V.1/10
  isPlayerSpeaking: 0
  text: "S\xED./nO eso acostumbro a decir./nYa sabe, estrategia de mercado./nLo \xFAnico
    que vendo son baratijas sin ning\xFAn valor."
  childrenIDs:
  - EQ_V.1/11
  - 11
  rect:
    serializedVersion: 2
    x: 1743
    y: 297
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
