  m_Name: 22
  m_EditorClassIdentifier: 
  uniqueID: EQ_V.1/22
  isPlayerSpeaking: 0
  text: "\xC9dgar se retira./nEl pueblo aprueba que perdones sus pecados./nTe sientes
    sucio."
  childrenIDs: []
