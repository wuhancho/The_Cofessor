  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 9
  m_EditorClassIdentifier: 
  uniqueID: 9
  isPlayerSpeaking: 0
  text: "Una sabia decisi\xF3n./nLos pecadores desean ser perdonados, mas debe cumplirse
    un precio./nEl sacramento de la penitencia es el castigo que debemos imponer
    sobre los pecadores./nSolo de esa forma podr\xE1n ganarse de nuevo el favor del
    todopoderoso./nTengo fe en que tomar\xE1 las decisiones correctas."
  childrenIDs:
  - 10
  rect:
    serializedVersion: 2
    x: 2090
    y: 243
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: -2415219595597414833, guid: 8cdab3cedb16a5f41b522a6f9908ceeb, type: 3}
--- !u!114 &2639277014555994808
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
