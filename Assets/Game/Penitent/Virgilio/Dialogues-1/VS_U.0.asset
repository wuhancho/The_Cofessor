  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  uniqueID: 4
  isPlayerSpeaking: 0
  text: "Ya sabe que tenemos unos dogmas que debemos cumplir./nMe gustar\xEDa verlo
    en acci\xF3n, padre./nHagamos un peque\xF1o juego./nMe har\xE9 pasar por una
    pobre alma en pena que acude a usted."
  childrenIDs:
  - 5
  rect:
    serializedVersion: 2
    x: 1044
    y: 1
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
