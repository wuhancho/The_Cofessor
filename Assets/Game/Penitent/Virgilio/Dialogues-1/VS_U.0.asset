  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 8
  m_EditorClassIdentifier: 
  uniqueID: 8
  isPlayerSpeaking: 0
  text: "Kej\u2026 kejeje./nSin duda la absoluci\xF3n es lo que desear\xE1n la mayor\xEDa
    de los que acudan aqu\xED./nPuede otorgarla si lo ve adecuado.../nMas recuerde
    que los pecados deben ser castigados como corresponde./nTengo fe en que tomar\xE1
    las decisiones correctas."
  childrenIDs:
  - 10
  rect:
    serializedVersion: 2
    x: 2100
    y: -6
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
