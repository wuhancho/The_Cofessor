  m_Name: 5
  m_EditorClassIdentifier: 
  uniqueID: VS_1/5
  isPlayerSpeaking: 0
  text: "Te equivocas, padre Abraham./nEres el gu\xEDa espiritual de este pueblo./nTu
    deber es traer luz en tiempos de oscuridad./nDebemos asegurarnos de que la fe
    del pueblo se mantenga alta./nNo me decepciones"
  childrenIDs:
  - VS_1/6
  - 6
  rect:
    serializedVersion: 2
    x: 744
    y: 241
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-7310150126230113902
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
