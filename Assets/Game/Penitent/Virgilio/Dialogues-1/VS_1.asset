  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: 
  uniqueID: VS_1/1
  isPlayerSpeaking: 0
  text: "Esto es un desastre./nTodo el pueblo habla ya sobre los amuletos m\xE1gicos
    que atraen la desgracia./nNo podemos permitir que estas blasfemias contin\xFAen./nAbraham,
    debes ponerle fin a esto de una vez."
  childrenIDs:
  - VS_1/2
  - VS_1/3
  - 2
  - 3
  rect:
    serializedVersion: 2
    x: 0
    y: 0
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
