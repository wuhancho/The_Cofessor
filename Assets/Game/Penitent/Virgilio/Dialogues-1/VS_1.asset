  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 9
  m_EditorClassIdentifier: 
  uniqueID: VS_1/9
  isPlayerSpeaking: 0
  text: "Me trae sin cuidado./nAl menos nos servir\xE1 como chivo expiatorio./nCon
    suerte, su alma podr\xE1 descansar en paz.../n\"Sabiendo que su muerte contribuy\xF3
    al bienestar del pueblo y su Iglesia."
  childrenIDs:
  - 11
  rect:
    serializedVersion: 2
    x: 1904
    y: -8
    width: 300
    height: 200
  faithCost: 0
