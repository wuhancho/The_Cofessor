--- !u!114 &3213220201847426655
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 6
  m_EditorClassIdentifier: 
  uniqueID: VS_1/6
  isPlayerSpeaking: 0
  text: "Seguro que entre los que han visitado la iglesia hoy, tienes alg\xFAn sospechoso
    de haber causado esta tragedia./nEncu\xE9ntralo y cast\xEDgalo./nPuedes utilizar
    la cripta de la iglesia para ello./nCon eso el pueblo quedar\xE1 complacido.../nY
    el pecado expiado."
  childrenIDs:
  - VS_1/7
  - VS_1/8
  - 7
  - 8
  rect:
    serializedVersion: 2
    x: 1141
    y: 114
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
