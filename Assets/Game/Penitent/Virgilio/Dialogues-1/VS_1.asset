  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  uniqueID: VS_1/4
  isPlayerSpeaking: 0
  text: "La gente del pueblo necesita ver que alguien paga por este incidente./nEstamos
    hablando de brujer\xEDa./nAlguien deber\xEDa acabar en la hoguera./nAs\xED ha
    sido siempre y as\xED ha de ser."
  childrenIDs:
  - VS_1/6
  - 6
