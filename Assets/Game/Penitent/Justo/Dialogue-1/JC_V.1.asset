  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 12
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/12
  isPlayerSpeaking: 1
  text: "Penitencia: Debe disculparse p\xFAblicamente y asegurar que har\xE1 todo
    lo que est\xE9 en su mano hasta llegar al fondo de esto."
  childrenIDs:
  - 16
  rect:
    serializedVersion: 2
    x: 2592
    y: -13
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 1
  RepPuebloCost: 0
