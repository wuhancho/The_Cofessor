  m_Name: 13
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/13
  isPlayerSpeaking: 1
  text: 'Denuncia: Miente a los aldeanos. Usted no es digno de su confianza.'
  childrenIDs:
  - 17
  rect:
    serializedVersion: 2
    x: 2595
    y: 194
    width: 300
    height: 200
  faithCost: -1
