  m_Name: 22
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/22
  isPlayerSpeaking: 0
  text: Don Justo se retira./nEl pueblo aprueba que perdones sus pecados./nTe sientes
    sucio.
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3341
    y: 393
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
