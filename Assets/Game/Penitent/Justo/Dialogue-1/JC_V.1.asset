  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 11
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/11
  isPlayerSpeaking: 1
  text: "No pienso dejar que nadie m\xE1s vea el cad\xE1ver./nY pienso asegurarme
    de que en el informe de la autopsia ponga que el muchacho muri\xF3 de lepra./nSoy
    consciente de que no es lo m\xE1s \xE9tico./nPero responda, padre./n\xBFEs un
    pecado mentir a mi pueblo... si con ello evito un caos mayor?/nSi me guarda el
    secreto, le recompensar\xE9 debidamente."
  childrenIDs:
  - JC_V.1/12
  - JC_V.1/13
  - JC_V.1/14
  - JC_V.1/15
  rect:
    serializedVersion: 2
    x: 2238
    y: 147
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: 0}
--- !u!114 &-8045171639687850742
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
