  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 19
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/19
  isPlayerSpeaking: 0
  text: "Hehehehe../nSab\xEDa yo que su santidad era un hombre inteligente./nSolo
    p\xEDdalo y le devolver\xE9 gustosamente el favor."
  childrenIDs:
  - 23
  rect:
    serializedVersion: 2
