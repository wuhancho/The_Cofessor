--- !u!114 &-2591812397738392348
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 18
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/18
  isPlayerSpeaking: 0
  text: "Sab\xEDa que lo entender\xEDa, padre./nEste pueblo necesita alguien que
    los lidere./nIncluso si, a veces, es necesario hacer peque\xF1os sacrificios."
  childrenIDs:
  - 22
  rect:
    serializedVersion: 2
    x: 2995
    y: 394
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
