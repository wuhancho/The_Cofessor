--- !u!114 &-4290082421060970763
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 5
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/5
  isPlayerSpeaking: 0
  text: "Ehem.../nPuede que tenga raz\xF3n./nRuego que disculpe mi osad\xEDa./nMas
    no me resulta conveniente que el pueblo viva con el temor a ser maldecidos por
    extra\xF1os objetos."
  childrenIDs:
  - JC_V.1/6
  rect:
    serializedVersion: 2
    x: 790
    y: 283
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
