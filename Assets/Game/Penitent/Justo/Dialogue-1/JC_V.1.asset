  m_Name: 17
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/17
  isPlayerSpeaking: 0
  text: "Hehehehe../nDenuncie todo lo que quiera./nYo soy el orden y la verdad en
    este pueblo./nNadie le creer\xE1./nT\xE9ngalo en mente antes de cometer una idiotez."
  childrenIDs:
  - 21
  rect:
