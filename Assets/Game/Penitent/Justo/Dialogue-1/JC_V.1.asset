  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 15
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/15
  isPlayerSpeaking: 1
  text: "Encubrimiento: Guardar\xE9 silencio. El pueblo no entender\xEDa su decisi\xF3n
    (+20$)."
  childrenIDs:
  - 19
  rect:
    serializedVersion: 2
    x: 2601.3613
    y: 591
    width: 300
    height: 200
  faithCost: -1
