  m_Name: 16
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/16
  isPlayerSpeaking: 0
  text: "Est\xE1 bien, si eso es lo que dice usted./nA\xFAn tendr\xE9 opciones para
