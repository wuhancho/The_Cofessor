--- !u!114 &-1886493288239368091
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 6
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/6
  isPlayerSpeaking: 0
  text: "Sea como fuere, yo mismo he de encargarme de acabar con estos rumores./nEl
    hijo del molinero falleci\xF3 a causa de una enfermedad./nEsa es la \xFAnica
    verdad./nLa \xFAnica verdad que necesita Castroviejo."
  childrenIDs:
  - JC_V.1/7
  - JC_V.1/8
  rect:
    serializedVersion: 2
    x: 1140
    y: 143
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: -8415742079868506637, guid: 2309dcb67cafec142b50b17f300824ff, type: 3}
