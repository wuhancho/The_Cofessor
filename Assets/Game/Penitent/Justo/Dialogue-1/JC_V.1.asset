--- !u!114 &-5318615668664465597
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/10
  isPlayerSpeaking: 0
  text: "Hehehehe.../nNi que fuera la primera vez que se hace/nResulta muy sencillo./nUn
    par de sellos por aqu\xED, otro par por all\xE1 y.../nLa verdad debe ser la que
    m\xE1s me conviene./nAs\xED es como se mantiene un pueblo en orden."
  childrenIDs:
  - JC_V.1/11
  rect:
    serializedVersion: 2
    x: 1844
    y: 289
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: 0}
--- !u!114 &-4742227157459718578
MonoBehaviour:
  m_ObjectHideFlags: 0
