  m_Name: 21
  m_EditorClassIdentifier: 
  uniqueID: JC_V.1/21
  isPlayerSpeaking: 0
  text: Don Justo se retira./nAl pueblo le disgustan tus acusaciones./nTe sientes
    bien.
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3330
    y: 193
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
