  m_Name: 14
  m_EditorClassIdentifier: 
  uniqueID: 14
  isPlayerSpeaking: 0
  text: Don Justo se retira
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3343
    y: 105
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
