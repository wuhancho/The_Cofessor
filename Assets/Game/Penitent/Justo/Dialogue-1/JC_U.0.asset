--- !u!114 &2384929094580413501
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 7
  m_EditorClassIdentifier: 
  uniqueID: 7
  isPlayerSpeaking: 0
  text: "Por eso quer\xEDa pedirle que retomara su lugar como gu\xEDa espiritual
    del pueblo./nLos aldeanos necesitan una luz que seguir, una esperanza a la que
    agarrarse en tiempos de oscuridad./nUsted, padre, es esa esperanza."
  childrenIDs:
  - 8
  rect:
    serializedVersion: 2
    x: 1546
    y: 118
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &4046174555186861942
