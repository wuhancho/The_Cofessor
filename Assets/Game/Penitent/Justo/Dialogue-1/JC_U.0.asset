  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 11
  m_EditorClassIdentifier: 
  uniqueID: 11
  isPlayerSpeaking: 1
  text: "Encubrimiento: Robar para alimemtar a su familia est\xE1 justificado. Su
    secreto est\xE1 a salvo conmigo."
  childrenIDs:
  - 13
  rect:
    serializedVersion: 2
    x: 2589
    y: 252
