  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  uniqueID: JC_M.1/4
  isPlayerSpeaking: 0
  text: "Ese colgante no existe./nEs un invento para llamar la atenci\xF3n./nEl muchacho
    muri\xF3 de lepra./nDe ello estoy seguro."
  childrenIDs:
  - JC_M.1/6
  rect:
