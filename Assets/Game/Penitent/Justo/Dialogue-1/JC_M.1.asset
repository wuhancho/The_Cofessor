    serializedVersion: 2
    x: 2243
    y: -2
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: -8415742079868506637, guid: 2309dcb67cafec142b50b17f300824ff, type: 3}
