  m_Name: 14
  m_EditorClassIdentifier: 
  uniqueID: JC_M.1/14
  isPlayerSpeaking: 1
  text: "Absoluci\xF3n: Miente, pero lo hace por Castroviejo. No podr\xEDa castigarle
