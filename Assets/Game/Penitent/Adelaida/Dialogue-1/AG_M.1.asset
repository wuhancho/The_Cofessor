  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: 10
  isPlayerSpeaking: 0
  text: "No tengo forma de saberlo./nRumores sobre amuletos m\xE1gicos circulan en
    el pueblo desde hace tiempo./nPuede que alguien los haya estado vendiendo a los
    incautos."
  childrenIDs:
  - 11
