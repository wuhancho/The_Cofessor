--- !u!114 &555188614452174015
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  uniqueID: 4
  isPlayerSpeaking: 0
  text: "S\xED.../nHace unos d\xEDas, una mujer vino a mi posada./nLlevaba consigo
    un lujoso colgante./nEncaja con la descripci\xF3n de la joya del peri\xF3dico."
  childrenIDs:
  - 6
  rect:
    serializedVersion: 2
    x: 649.8462
    y: 133.84615
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
