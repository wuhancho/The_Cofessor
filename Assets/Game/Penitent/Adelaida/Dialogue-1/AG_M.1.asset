  m_Name: 7
  m_EditorClassIdentifier: 
  uniqueID: 7
  isPlayerSpeaking: 1
  text: "\xBFPor qu\xE9 no denunci\xF3 a la mujer?"
  childrenIDs:
  - 9
  rect:
