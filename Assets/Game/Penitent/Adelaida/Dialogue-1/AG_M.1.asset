  m_Name: 22
  m_EditorClassIdentifier: 
  uniqueID: 22
  isPlayerSpeaking: 0
  text: "Gracias, padre./nAunque eso no cure mi culpa, nunca olvidar\xE9 su comprensi\xF3n
    y caridad."
  childrenIDs:
  - 23
  rect:
