  m_Name: 1
  m_EditorClassIdentifier: 
  uniqueID: 1
  isPlayerSpeaking: 0
  text: "Yo misma le dije que se desiciera del amuleto. No pod\xEDa permitir que
    un objeto m\xE1gico pusiera en peligro mi negocio. Mas nunca pens\xE9 que se
    lo entregar\xEDa a un ni\xF1o... La mujer abandon\xF3 el pueblo poco despu\xE9s.
    Tal vez, carcomida por la culpa de lo que hab\xEDa hecho."
  childrenIDs:
  - 2
  - 3
  - 9
  rect:
    serializedVersion: 2
    x: 3.5742645
    y: 251.18655
    width: 300
    height: 200
