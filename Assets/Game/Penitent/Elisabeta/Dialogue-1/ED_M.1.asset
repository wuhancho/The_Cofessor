  m_Name: 5
  m_EditorClassIdentifier: 
  uniqueID: ED_M.1/5
  isPlayerSpeaking: 0
  text: "\xBFConfesarme? \xBFYo?/nFufufufu.../nSolo estoy aqu\xED como una mera observadora."
