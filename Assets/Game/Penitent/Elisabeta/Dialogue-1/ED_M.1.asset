  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 13
  m_EditorClassIdentifier: 
  uniqueID: ED_M.1/13
  isPlayerSpeaking: 0
  text: "No tengo nada m\xE1s que decirle, Abraham./n\xBFHar\xE1 usted justicia?/nEl
    pueblo reclama que alguien pague por este atroz acto./nMe pregunto a qui\xE9n
    escoger\xE1."
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 2642.57
    y: 394
    width: 300
    height: 200
