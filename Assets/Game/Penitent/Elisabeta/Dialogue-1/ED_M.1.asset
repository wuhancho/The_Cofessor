  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 12
  m_EditorClassIdentifier: 
  uniqueID: ED_M.1/12
  isPlayerSpeaking: 0
  text: "El amuleto tiene voluntad propia./nDesea cargarse, as\xED que incita a las
    personas a pon\xE9rselo y as\xED arrebatarles la vida./nRequiere una voluntad
    muy fuerte para deshacerse de su influencia./nA menudo, requiere ayuda externa
    para quit\xE1rselo."
  childrenIDs:
  - ED_M.1/13
  - 13
  rect:
    serializedVersion: 2
    x: 2242
    y: -6
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: 8288426215254106694, guid: a1347a34fee077c46bb4de37f94af7b4, type: 3}
--- !u!114 &-6279793652232251838
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
