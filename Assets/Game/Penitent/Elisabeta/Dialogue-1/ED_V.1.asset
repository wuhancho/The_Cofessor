  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  uniqueID: ED_V.1/4
  isPlayerSpeaking: 0
  text: "Ya veo. Eso es bueno./nEl alma de ese chico merece que se haga justicia./n\xBFY
    usted?/n\xBFHar\xE1 justicia?"
  childrenIDs:
  - ED_V.1/6
  - 6
