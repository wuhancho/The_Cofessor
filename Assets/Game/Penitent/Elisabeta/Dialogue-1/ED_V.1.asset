  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: ED_V.1/10
  isPlayerSpeaking: 0
  text: "El colgante lo mat\xF3./nEn cuesti\xF3n de horas, absorvi\xF3 toda la esperanza
    de vida del muchacho./nRedujo su cuerpo a una masa reseca y \xE1spera, como el
    tronco de un \xE1rbol./nFui a ver el cad\xE1ver con mis propios ojos cuando me
    enter\xE9 de lo ocurrido./nAh./nCuando fui hacia all\xED, vi al alcalde y al
    mercader salir corriendo."
  childrenIDs:
  - ED_V.1/11
  - 11
  rect:
    serializedVersion: 2
    x: 1793
    y: 295
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: 8288426215254106694, guid: a1347a34fee077c46bb4de37f94af7b4, type: 3}
--- !u!114 &5147466379584944915
