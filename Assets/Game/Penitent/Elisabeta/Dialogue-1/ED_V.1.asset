  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 9
  m_EditorClassIdentifier: 
  uniqueID: ED_V.1/9
  isPlayerSpeaking: 0
  text: "Es un colgante m\xE1gico tan antiguo como el hambre./nOtorga la vida eterna
    a su portador.../nSolo si su poder ha sido cargado./nPara ello, el colgante absorve
    la esperanza de vida de sus portadores previos./nSin duda, alguien conoc\xEDa
    sus efectos y decidi\xF3 deshacerse de \xE9l."
  childrenIDs:
  - ED_V.1/11
  - 11
  rect:
    serializedVersion: 2
    x: 1797
    y: -5
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
  reactionPenitent: {fileID: -5009680308845635104, guid: a1347a34fee077c46bb4de37f94af7b4, type: 3}
--- !u!114 &-8319638898687170277
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
