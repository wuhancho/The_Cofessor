  m_Name: 7
  m_EditorClassIdentifier: 
  uniqueID: ED_V.1/7
  isPlayerSpeaking: 1
  text: "\xBFQu\xE9 me puedes decir sobre el colgante?"
  childrenIDs:
  - ED_V.1/9
  - 9
