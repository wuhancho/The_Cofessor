--- !u!114 &4135112824218030038
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 17
  m_EditorClassIdentifier: 
  uniqueID: 17
  isPlayerSpeaking: 0
  text: 'Adelaida se retira.

    La iglesia acepta la penitencia impuesta para expiar
    sus pecados.'
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 3136.093
    y: 5.342987
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &6312898203090840736
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 12
  m_EditorClassIdentifier: 
  uniqueID: 12
  isPlayerSpeaking: 1
  text: "Penitencia: Pida perd\xF3n a la familia y presta tus servivios en todo lo
    que necesiten."
  childrenIDs:
  - 16
  rect:
    serializedVersion: 2
    x: 2434.093
    y: 7.342987
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 1
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &7711275868027788743
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 20
  m_EditorClassIdentifier: 
  uniqueID: 20
  isPlayerSpeaking: 0
  text: "Escucharlo de su boca libera la carga en mi coraz\xF3n.\r\nSe lo agradezco,
