--- !u!114 &-7442400721536414157
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: 10
  isPlayerSpeaking: 0
  text: "No estoy del todo segura.\r\nAunque \xC9dgar, el mercader errante, es famoso
    en la regi\xF3n por vender toda clase de objetos extra\xF1os.\r\nQuiz\xE1 \xE9l
    sepa algo.\r\nLa mujer asegur\xF3 que, quien se lo vendi\xF3, le asegur\xF3 que
    el colgante har\xEDa que su aspecto quedara congelado en el tiempo."
  childrenIDs:
  - 11
  rect:
    serializedVersion: 2
    x: 1764.093
    y: 255.34299
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
