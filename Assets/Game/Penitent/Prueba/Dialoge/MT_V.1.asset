  m_Name: 8
  m_EditorClassIdentifier: 
  uniqueID: 8
  isPlayerSpeaking: 1
  text: "\xBFD\xF3nde consigui\xF3 la mujer el amuleto?"
  childrenIDs:
  - 10
  rect:
    serializedVersion: 2
    x: 1404.093
    y: 260.343
    width: 300
    height: 200
