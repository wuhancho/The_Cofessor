--- !u!114 &-6279852445840306227
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 22
  m_EditorClassIdentifier: 
  uniqueID: 22
  isPlayerSpeaking: 0
  text: "Gracias, padre.\r\nAunque eso no cure mi culpa, nunca olvidar\xE9 su comprensi\xF3n
    y caridad."
  childrenIDs:
  - 23
  rect:
    serializedVersion: 2
    x: 2794.093
    y: 602.343
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-5897488064599485638
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
