  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 14
  m_EditorClassIdentifier: 
  uniqueID: 14
  isPlayerSpeaking: 1
  text: "Absoluci\xF3n: Solo estabas tratando de hacer lo correcto por ti y los tuyos."
  childrenIDs:
  - 20
  rect:
    serializedVersion: 2
    x: 2436.093
    y: 398.343
