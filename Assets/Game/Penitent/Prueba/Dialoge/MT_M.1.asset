  m_Name: 2
  m_EditorClassIdentifier: 
  uniqueID: 2
  isPlayerSpeaking: 1
  text: "\xBFHab\xEDa visto el amuleto antes?"
  childrenIDs:
  - 4
  rect:
    serializedVersion: 2
    x: 333
    y: 128
    width: 300
    height: 200
