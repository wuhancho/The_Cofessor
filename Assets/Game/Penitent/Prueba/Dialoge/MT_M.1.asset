  m_Name: 21
  m_EditorClassIdentifier: 
  uniqueID: 21
  isPlayerSpeaking: 0
  text: '[Adelaida se retira.


    Los aldeanos aprueban que mantengas sus confesiones
    en secreto.

    Te sientes bien.'
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 2693
    y: 660
    width: 300
    height: 200
