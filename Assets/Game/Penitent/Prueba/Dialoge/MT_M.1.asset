--- !u!114 &555188614452174015
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 4
  m_EditorClassIdentifier: 
  uniqueID: 4
  isPlayerSpeaking: 0
  text: "S\xED...\r\nHace unos d\xEDas, una mujer vino a mi posada.\r\nLlevaba consigo
    un lujoso colgante.\r\nEncaja con la descripci\xF3n de la joya del peri\xF3dico."
  childrenIDs:
  - 6
  rect:
    serializedVersion: 2
    x: 646
    y: 130
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &2664405150541387646
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 20
  m_EditorClassIdentifier: 
  uniqueID: 20
  isPlayerSpeaking: 0
  text: "Gracias, padre.\nAunque eso no cure mi culpa, nunca olvidar\xE9 su comprensi\xF3n
    y caridad."
  childrenIDs:
  - 21
  rect:
    serializedVersion: 2
    x: 2370
    y: 656
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &2816187387651695356
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
