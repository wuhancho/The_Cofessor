  m_Name: 17
  m_EditorClassIdentifier: 
  uniqueID: 17
  isPlayerSpeaking: 0
  text: '[Adelaida se retira.


    La iglesia aprueba que sus pecados sean castigados.

    El
    pueblo desaprueba que delates los secretos que te confiesan.'
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 2695
