  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 19
  m_EditorClassIdentifier: 
  uniqueID: 19
  isPlayerSpeaking: 0
  text: 'Adelaida se retira.


    La iglesia desaprueba que perdones sus pecados.

    Te
    sientes bien.'
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 2696
    y: 457
    width: 300
    height: 200
  faithCost: 0
