  m_Name: 12
  m_EditorClassIdentifier: 
  uniqueID: 12
  isPlayerSpeaking: 1
  text: "Absoluci\xF3n: Solo estabas tratando de hacer lo correcto por ti y los tuyos."
  childrenIDs:
  - 18
  rect:
    serializedVersion: 2
    x: 2054
    y: 453
    width: 300
    height: 200
  faithCost: 1
  RepIglesiaCost: -1
  RepPuebloCost: 0
