  m_Name: 15
  m_EditorClassIdentifier: 
  uniqueID: 15
  isPlayerSpeaking: 0
  text: 'Adelaida se retira.


    La iglesia acepta la penitencia impuesta para
    expiar sus pecados.'
  childrenIDs: []
  rect:
    serializedVersion: 2
    x: 2688
    y: 33
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
