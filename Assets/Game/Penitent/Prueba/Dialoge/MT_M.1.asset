--- !u!114 &-4482264716366443592
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 18
  m_EditorClassIdentifier: 
  uniqueID: 18
  isPlayerSpeaking: 0
  text: "Escucharlo de su boca libera la carga en mi coraz\xF3n.\nSe lo agradezco,
    padre.\nMe asegurar\xE9 de que el sacrificio de aquel chico no sea en vano."
  childrenIDs:
  - 19
  rect:
    serializedVersion: 2
    x: 2372
    y: 457
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-4031433879958399830
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 7
  m_EditorClassIdentifier: 
  uniqueID: 7
  isPlayerSpeaking: 1
  text: "No lo vi necesario.\r\nMientras se mantuviera lejos de mi negocio...\r\nLos
    problemas se mantendr\xEDan al otro lado de la puerta."
  childrenIDs:
  - 9
  rect:
    serializedVersion: 2
    x: 1347
    y: 132
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-3719600038221277022
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 8
  m_EditorClassIdentifier: 
  uniqueID: 8
  isPlayerSpeaking: 1
  text: "No tengo forma de saberlo.\r\nRumores sobre amuletos m\xE1gicos circulan
    en el pueblo desde hace tiempo.\r\nPuede que alguien los haya estado vendiendo
    a los incautos."
  childrenIDs:
  - 9
  rect:
    serializedVersion: 2
    x: 1349
    y: 374
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-3156734886151203310
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 10
  m_EditorClassIdentifier: 
  uniqueID: 10
  isPlayerSpeaking: 1
  text: "Penitencia: Pida perd\xF3n a la familia y presta tus servivios en todo lo
    que necesiten."
  childrenIDs:
  - 14
  rect:
    serializedVersion: 2
    x: 2053
    y: 31
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 1
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-2572561148067046585
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 14
  m_EditorClassIdentifier: 
  uniqueID: 14
  isPlayerSpeaking: 0
  text: "Entendido, padre.\r\nEs lo m\xE1s justo si pretendo liberarme de la culpa
    que siento."
  childrenIDs:
  - 15
  rect:
    serializedVersion: 2
    x: 2368
    y: 32
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-973457926264050994
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a710203670c9fa140b55d5de41d5d82b, type: 3}
  m_Name: 16
  m_EditorClassIdentifier: 
  uniqueID: 16
  isPlayerSpeaking: 0
  text: "\xBFPERDONE?\r\nPens\xE9 que su santidad respetar\xEDa el secreto de confesi\xF3n.\r\nSepa
    que, si me denuncia, pondr\xE1 en peligro mi negocio.\r\nNo puedo permitirlo.\r\nA
    los vecinos no les gustar\xE1 esto."
  childrenIDs:
  - 17
  rect:
    serializedVersion: 2
    x: 2366
    y: 255
    width: 300
    height: 200
  faithCost: 0
  RepIglesiaCost: 0
  RepPuebloCost: 0
  SobornoCost: 0
--- !u!114 &-936220729865665587
MonoBehaviour:
  m_ObjectHideFlags: 0
